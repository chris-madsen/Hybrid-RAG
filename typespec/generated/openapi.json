{
  "openapi": "3.0.0",
  "info": {
    "title": "ACE Native Responses Projection",
    "version": "2.0.0"
  },
  "tags": [],
  "paths": {
    "/internal/ace-gateway/v2/capabilities": {
      "get": {
        "operationId": "capabilities",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayCapabilities"
                }
              }
            }
          }
        }
      }
    },
    "/internal/ace-gateway/v2/health": {
      "get": {
        "operationId": "health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayHealth"
                }
              }
            }
          }
        }
      }
    },
    "/internal/ace-gateway/v2/project": {
      "post": {
        "operationId": "project",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectionDecision"
                }
              }
            }
          },
          "400": {
            "description": "The server could not understand the request due to invalid syntax.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayError"
                }
              }
            }
          },
          "401": {
            "description": "Access is unauthorized.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayError"
                }
              }
            }
          },
          "404": {
            "description": "The server cannot find the requested resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayError"
                }
              }
            }
          },
          "405": {
            "description": "Client error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayError"
                }
              }
            }
          },
          "409": {
            "description": "The request conflicts with the current state of the server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayError"
                }
              }
            }
          },
          "413": {
            "description": "Client error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayError"
                }
              }
            }
          },
          "501": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayError"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectionRequest"
              }
            }
          }
        }
      }
    },
    "/internal/ace-gateway/v2/record-delivery": {
      "post": {
        "operationId": "recordDelivery",
        "parameters": [],
        "responses": {
          "501": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryNotCertified"
                }
              }
            }
          }
        },
        "x-ace-final-provider-wire": "not_certified"
      }
    }
  },
  "components": {
    "schemas": {
      "BlockedProjection": {
        "type": "object",
        "required": [
          "kind",
          "baseBodySha256",
          "reasonCode"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "BLOCK"
            ]
          },
          "baseBodySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reasonCode": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "DeliveryNotCertified": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "PROVIDER_WIRE_NOT_CERTIFIED"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": {
              "not": {}
            }
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "GatewayCapabilities": {
        "type": "object",
        "required": [
          "schemaVersion",
          "routes",
          "maxBodyBytes",
          "projectionModes",
          "providerWireCertification"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "enum": [
              "ace.gateway.v2"
            ]
          },
          "routes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GatewayRouteCapability"
            }
          },
          "maxBodyBytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "projectionModes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "gateway"
              ]
            }
          },
          "providerWireCertification": {
            "type": "string",
            "enum": [
              "not_certified"
            ]
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "GatewayError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": {
              "not": {}
            }
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "GatewayHealth": {
        "type": "object",
        "required": [
          "schemaVersion",
          "liveness",
          "readiness",
          "providerWire"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "enum": [
              "ace.gateway.v2"
            ]
          },
          "liveness": {
            "type": "string",
            "enum": [
              "ready"
            ]
          },
          "readiness": {
            "type": "string",
            "enum": [
              "adapter_implemented"
            ]
          },
          "providerWire": {
            "type": "string",
            "enum": [
              "not_certified"
            ]
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "GatewayRouteCapability": {
        "type": "object",
        "required": [
          "protocol",
          "mode",
          "capability"
        ],
        "properties": {
          "protocol": {
            "type": "string",
            "enum": [
              "openai.responses"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "structured"
            ]
          },
          "capability": {
            "type": "string",
            "enum": [
              "NATIVE_RESPONSES_NOT_CERTIFIED"
            ]
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "HostCompactionAttestation": {
        "type": "object",
        "required": [
          "hostBuildDigest",
          "sessionId",
          "activeEngineId",
          "effectiveCompressionControlsDigest",
          "durableActiveTranscriptRevision",
          "durableActiveTranscriptDigest",
          "hostCompactionEpoch",
          "attestorId",
          "providerManagedHistoryCapability",
          "hostTranscriptAttested",
          "compactionEnabled"
        ],
        "properties": {
          "hostBuildDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sessionId": {
            "type": "string",
            "minLength": 1
          },
          "parentSessionId": {
            "type": "string",
            "minLength": 1
          },
          "activeEngineId": {
            "type": "string",
            "minLength": 1
          },
          "effectiveCompressionControlsDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "durableActiveTranscriptRevision": {
            "type": "string",
            "minLength": 1
          },
          "durableActiveTranscriptDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "hostCompactionEpoch": {
            "anyOf": [
              {
                "type": "integer",
                "format": "int64"
              },
              {
                "type": "string",
                "enum": [
                  "unknown"
                ]
              }
            ]
          },
          "attestorId": {
            "type": "string",
            "minLength": 1
          },
          "providerManagedHistoryCapability": {
            "type": "string",
            "enum": [
              "visible",
              "hidden",
              "unknown"
            ]
          },
          "hostTranscriptAttested": {
            "type": "boolean"
          },
          "compactionEnabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "PreparedProjection": {
        "type": "object",
        "required": [
          "kind",
          "baseBodySha256",
          "projectedBodySha256",
          "bodyBase64",
          "reasonCode"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "PREPARED"
            ]
          },
          "baseBodySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "projectedBodySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bodyBase64": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          },
          "reasonCode": {
            "type": "string",
            "enum": [
              "VERIFIED_CONTEXT_ADDED"
            ]
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "ProjectionDecision": {
        "type": "object",
        "oneOf": [
          {
            "$ref": "#/components/schemas/PreparedProjection"
          },
          {
            "$ref": "#/components/schemas/BlockedProjection"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "PREPARED": "#/components/schemas/PreparedProjection",
            "BLOCK": "#/components/schemas/BlockedProjection"
          }
        }
      },
      "ProjectionRequest": {
        "type": "object",
        "required": [
          "schemaVersion",
          "protocol",
          "requestId",
          "attemptGroupId",
          "agentSessionId",
          "workspaceId",
          "dataClass",
          "provider",
          "model",
          "bodyBase64",
          "bodySha256",
          "query",
          "projectionMode",
          "deadlineEpochMs",
          "attestation"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "enum": [
              "ace.gateway.v2"
            ]
          },
          "protocol": {
            "type": "string",
            "enum": [
              "openai.responses"
            ]
          },
          "requestId": {
            "type": "string",
            "minLength": 1
          },
          "attemptGroupId": {
            "type": "string",
            "minLength": 1
          },
          "agentSessionId": {
            "type": "string",
            "minLength": 1
          },
          "workspaceId": {
            "type": "string",
            "minLength": 1
          },
          "dataClass": {
            "type": "string",
            "enum": [
              "private",
              "project_document",
              "public"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "bodyBase64": {
            "type": "string",
            "maxLength": 5592408,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          },
          "bodySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "projectionMode": {
            "type": "string",
            "enum": [
              "gateway"
            ]
          },
          "deadlineEpochMs": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "attestation": {
            "$ref": "#/components/schemas/HostCompactionAttestation"
          }
        },
        "additionalProperties": {
          "not": {}
        }
      }
    }
  }
}
