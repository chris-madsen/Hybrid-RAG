{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "PreparedProjection.json",
    "type": "object",
    "properties": {
        "kind": {
            "type": "string",
            "const": "PREPARED"
        },
        "baseBodySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "projectedBodySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "bodyBase64": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "reasonCode": {
            "type": "string",
            "const": "VERIFIED_CONTEXT_ADDED"
        }
    },
    "required": [
        "kind",
        "baseBodySha256",
        "projectedBodySha256",
        "bodyBase64",
        "reasonCode"
    ],
    "unevaluatedProperties": {
        "not": {}
    }
}