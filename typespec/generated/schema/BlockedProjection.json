{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "BlockedProjection.json",
    "type": "object",
    "properties": {
        "kind": {
            "type": "string",
            "const": "BLOCK"
        },
        "baseBodySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "reasonCode": {
            "type": "string"
        }
    },
    "required": [
        "kind",
        "baseBodySha256",
        "reasonCode"
    ],
    "unevaluatedProperties": {
        "not": {}
    }
}