# syntax=docker/dockerfile:1

# No mutable/default base is accepted for a release image. Supply an exact
# digest, e.g. --build-arg ACE_NODE_IMAGE=node:22-bookworm-slim@sha256:<verified>.
ARG ACE_NODE_IMAGE
FROM ${ACE_NODE_IMAGE} AS ace-base

WORKDIR /opt/ace

USER root
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json tsconfig.json ./
RUN npm ci --ignore-scripts

COPY src ./src
COPY scripts ./scripts
COPY integrations ./integrations
# Compilation and git-bound provenance happen in the source checkout before
# docker build; neither .git nor git itself is required in the image.
COPY dist ./dist
RUN npm prune --omit=dev --ignore-scripts \
  && node --input-type=module -e 'import { verifyCompiledRuntimeProvenance } from "./dist/application/runtime-provenance.js"; const root = process.cwd(); const verified = await verifyCompiledRuntimeProvenance(root, `${root}/dist/bin/ace-runtime.js`); if (verified._tag !== "Ok") throw new Error(verified.error.message);' \
  && mkdir -p /var/lib/ace/state /var/lib/ace/artifacts /tmp/ace \
  && chown -R node:node /var/lib/ace /tmp/ace

ENV ACE_STATE_DIR=/var/lib/ace/state \
    ACE_ARTIFACT_DIR=/var/lib/ace/artifacts \
    TMPDIR=/tmp

# Candidate single native target. Historical adapter dependencies are removed
# in subsequent CBM-05 slices; no Python embedding runtime is installed.
FROM ace-base AS native-cbm
RUN apt-get update \
  && apt-get install -y --no-install-recommends git procps \
  && rm -rf /var/lib/apt/lists/* \
  && npm install --global codebase-memory-mcp@0.12.1 \
  && mkdir -p /opt/ace-native \
  && install -m 0755 "$(npm root -g)/codebase-memory-mcp/bin/codebase-memory-mcp" /opt/ace-native/codebase-memory-mcp \
  && /opt/ace-native/codebase-memory-mcp --version \
  && npm uninstall --global codebase-memory-mcp \
  && ln -s /opt/ace-native/codebase-memory-mcp /usr/local/bin/codebase-memory-mcp \
  && mkdir -p /var/lib/ace/native-home \
  && chown node:node /var/lib/ace/native-home
ENV HOME=/var/lib/ace/native-home \
    ACE_CODE_RETRIEVAL_MODE=cbm \
    ACE_ENABLE_EXPERIMENTAL_QDRANT=false \
    ACE_RERANKER_MODE=disabled
USER node
CMD ["node", "/opt/ace/dist/bin/ace-runtime.js"]

